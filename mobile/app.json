{
  "expo": {
    "name": "The Magic Trader",
    "slug": "the-magic-trader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "magictrader",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#05050D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.magictrader.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Permite gravar comentários de áudio na Comunidade.",
        "NSPhotoLibraryUsageDescription": "Permite anexar imagens nas mensagens da Comunidade."
      }
    },
    "android": {
      "package": "com.magictrader.app",
      "adaptiveIcon": {
        "backgroundColor": "#05050D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/fix-splash-window",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05050D",
          "image": "./assets/images/splash-full.png",
          "imageWidth": 300,
          "enableFullScreenImageLegacy": true,
          "dark": {
            "backgroundColor": "#05050D",
            "image": "./assets/images/splash-full.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permite gravar comentários de áudio na Comunidade."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00c853",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite anexar imagens nas mensagens da Comunidade."
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "image/*"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "112173d7-48e2-4d95-9c98-abd9f16be18a"
      }
    }
  }
}
