# Copia para .env e preenche com os valores reais.
# As mesmas credenciais usadas na web (Supabase / Vercel).
# Env vars do Expo DEVEM ter o prefixo EXPO_PUBLIC_ para ficarem no bundle.

# Projeto Supabase (project_id real = zwxplzdadgtiohnuotlu)
EXPO_PUBLIC_SUPABASE_URL=https://zwxplzdadgtiohnuotlu.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Emails de administrador (separados por vírgula)
EXPO_PUBLIC_ADMIN_EMAILS=

# Preços Stripe (Price IDs, iguais aos VITE_* da web)
EXPO_PUBLIC_STRIPE_PRICE_USD=
EXPO_PUBLIC_STRIPE_PRICE_AOA=
EXPO_PUBLIC_STRIPE_PRICE_BASIC_USD=
EXPO_PUBLIC_STRIPE_PRICE_BASIC_AOA=
EXPO_PUBLIC_STRIPE_PRICE_PRO_USD=
EXPO_PUBLIC_STRIPE_PRICE_PRO_AOA=
EXPO_PUBLIC_STRIPE_PRICE_PREMIUM_USD=
EXPO_PUBLIC_STRIPE_PRICE_PREMIUM_AOA=

# URL da edge function stripe-checkout (Sem a barra final)
EXPO_PUBLIC_STRIPE_CHECKOUT_URL=https://zwxplzdadgtiohnuotlu.supabase.co/functions/v1/stripe-checkout

# Twelve Data (grátis: twelvedata.com → criar conta → copiar API key)
# Usado para preços forex reais (EUR/USD, GBP/USD, etc.)
EXPO_PUBLIC_TWELVE_DATA_KEY=

# Forex Calendar Pro (grátis: forex-calendar.pro → dashboard → copiar API key)
# Usado para calendário económico (NFP, CPI, FOMC, etc.)
EXPO_PUBLIC_FOREX_CALENDAR_KEY=
