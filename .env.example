# Copia para .env e preenche com os valores reais.
#
# As chaves da web sao lidas por Vite: so ficam expostas ao browser as que
# comecam por VITE_. Nunca renomeies uma secreta para VITE_ -- ela passa a
# ser publica. As chaves de servidor (SERVICE_ROLE_KEY, STRIPE_SECRET_KEY)
# vivem nos secrets do Supabase, nunca num .env do cliente.

# --- Supabase (publico) ---
VITE_SUPABASE_URL=https://zwxplzdadgtiohnuotlu.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Admin ---
# Emails de administrador, separados por virgula.
VITE_ADMIN_EMAILS=

# --- Cambio ---
# Kwanza por 1 USD, usado para mostrar os precos em AOA.
VITE_AOA_PER_USD=

# --- Calendario economico ---
# Forex Calendar Pro (forex-calendar.pro -> dashboard -> API key).
# Usado para os eventos economicos (NFP, CPI, FOMC, ...).
VITE_FOREX_CALENDAR_KEY=

# NOTA: a web nao usa os Price IDs do Stripe. O checkout Stripe e um caminho
# do app mobile (mobile/.env.example -> EXPO_PUBLIC_STRIPE_PRICE_*), e na web a
# compra e um pedido manual em Kwanzas via /depositos.
